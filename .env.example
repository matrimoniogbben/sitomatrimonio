# Server
PORT=3000
NODE_ENV=production
# Inserisci il dominio Vercel in produzione, senza slash finale.
CORS_ORIGIN=https://tuo-progetto.vercel.app

# Password area riservata
ADMIN_USER=gbeben
ADMIN_PASS=cambia-questa-password

# Backup locale per lo sviluppo. Con R2 configurato, quiz (domande, ordine e
# tentativi), messaggi e metadati foto risiedono in R2 e sopravvivono a deploy
# e riavvii di Render. Il file locale viene copiato in R2 solo se la chiave R2
# non esiste ancora; un errore R2 non puo mai sovrascrivere dati esistenti.
DATA_FILE=./data/data.json

# Cloudflare R2
# Endpoint generato automaticamente come:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=gloria-beniamino-wedding
R2_REGION=auto
# Chiave R2 che contiene quiz, messaggi e indice delle foto.
R2_DATA_KEY=site-data/data.json

# Facoltativo: URL pubblico del bucket o custom domain.
# Se lasciato vuoto, il server genera URL temporanei firmati per visualizzare/scaricare.
R2_PUBLIC_BASE_URL=

# Upload
MAX_UPLOAD_MB=8
SIGNED_URL_EXPIRES_SECONDS=900
PHOTO_PREVIEW_EXPIRES_SECONDS=900
